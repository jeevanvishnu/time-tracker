{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://time-tracker-whk2.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ]
}
